# Environment variable template — Demon Time Exotics monorepo
#
# Copy to `.env` and fill in values. NEVER commit `.env` — it's gitignored.
# All values are OPTIONAL; apps run without them using sensible defaults.

# --- YouTube (packages/core feeds, landing live-embed) ----------------------
# Channel ID for @DTEMONEY448 (used for live-stream detection / embeds)
DTE_YOUTUBE_CHANNEL_ID=UC4mSdocvseflT-Tubw9xOnw

# YouTube Data API v3 key (optional — enables live sub/view counts + latest
# videos feed on the landing site). Create at console.cloud.google.com
DTE_YOUTUBE_API_KEY=

# --- Analytics (apps/landing) ----------------------------------------------
# Optional analytics/measurement ID (e.g. GA4 G-XXXXXXX)
DTE_ANALYTICS_ID=

# --- Support / monetization -------------------------------------------------
# Ko-fi username — replaces YOUR_USERNAME in support buttons app-wide
DTE_KOFI_USERNAME=

# --- Electron build (optional, CI secrets preferred) -----------------------
# AUTO_UPDATE GitHub repo in "owner/name" form for electron-builder publish
DTE_ELECTRON_UPDATE_REPO=DTEMONEY448/demon-time-exotics

# --- Expo / EAS (optional, CI secrets preferred) ---------------------------
# EAS access token (eas whoami / expo.dev → account settings)
DTE_EXPO_TOKEN=

# NOTE: Tauri signing keys (TAURI_SIGNING_PRIVATE_KEY, etc.) and Apple
# signing secrets belong ONLY in GitHub Actions secrets — never in .env.
