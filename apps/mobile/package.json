{
  "name": "@dte/mobile",
  "version": "1.0.0",
  "private": true,
  "description": "DEMON TIME EXOTICS — THE MESSY SHOW mobile app (Expo SDK 51 / React Native with Expo Router).",
  "type": "module",
  "license": "SEE LICENSE IN LICENSE",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build": "expo export --platform web",
    "build:android": "expo export --platform android",
    "build:ios": "expo export --platform ios",
    "prebuild": "expo prebuild",
    "typecheck": "tsc --noEmit",
    "lint": "eslint app src --ext .ts,.tsx",
    "test": "jest",
    "clean": "rm -rf dist .expo .turbo"
  },
  "dependencies": {
    "@dte/core": "workspace:*",
    "@dte/shared": "workspace:*",
    "@dte/ui": "workspace:*",
    "expo": "~51.0.0",
    "@react-navigation/native": "^6.1.18",
    "expo-constants": "~16.0.0",
    "expo-linking": "~6.3.1",
    "expo-router": "~3.5.0",
    "expo-status-bar": "~1.12.1",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-native": "0.74.5",
    "react-native-safe-area-context": "4.10.5",
    "react-native-screens": "3.31.1",
    "react-native-web": "~0.19.9"
  },
  "devDependencies": {
    "@dte/config-typescript": "workspace:*",
    "@types/react": "~18.2.79",
    "typescript": "^5.6.3"
  }
}
