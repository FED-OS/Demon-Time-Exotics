{
  "$schema": "https://schema.tauri.app/capability/2",
  "identifier": "default",
  "description": "Default capability set for the DTE desktop window: open external platform URLs, run stream-status shell checks, and receive core events.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:webview:allow-internal-toggle-devtools",
    "opener:default",
    "opener:allow-open-url",
    "shell:allow-spawn",
    "shell:allow-execute"
  ]
}
