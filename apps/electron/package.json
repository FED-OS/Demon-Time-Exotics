{
  "name": "@dte/electron",
  "version": "1.0.0",
  "private": true,
  "description": "DEMON TIME EXOTICS — THE MESSY SHOW desktop app built with Electron (main/preload/renderer separation, context isolation).",
  "type": "module",
  "license": "SEE LICENSE IN LICENSE",
  "main": "dist/main/index.js",
  "author": {
    "name": "Demon Time Exotics",
    "email": "Bigmoney@demontimeexotics.com",
    "url": "https://www.youtube.com/@DTEMONEY448"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc -p tsconfig.build.json && vite build --config vite.renderer.config.ts",
    "build:fast": "vite build --config vite.renderer.config.ts",
    "start": "electron .",
    "package": "electron-builder --dir",
    "dist": "electron-builder",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts,.tsx",
    "clean": "rm -rf dist release .turbo"
  },
  "dependencies": {
    "@dte/core": "workspace:*",
    "@dte/shared": "workspace:*",
    "@dte/ui": "workspace:*"
  },
  "devDependencies": {
    "@dte/config-typescript": "workspace:*",
    "@dte/config-vite": "workspace:*",
    "electron": "^44.3.0",
    "electron-builder": "^25.1.8",
    "typescript": "^5.6.3",
    "vite": "^8.3.0"
  }
}
