{
  "name": "@dte/core",
  "version": "1.0.0",
  "private": true,
  "description": "Demon Time Exotics — app-logic core: API client, auth stubs, stores, domain services over the @dte/shared data layer.",
  "type": "module",
  "license": "SEE LICENSE IN LICENSE",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./links": "./src/links.ts",
    "./stats": "./src/stats.ts",
    "./figures": "./src/figures.ts",
    "./pillars": "./src/pillars.ts",
    "./content": "./src/content.ts",
    "./api": "./src/api/index.ts",
    "./auth": "./src/auth/index.ts",
    "./stores": "./src/stores/index.ts",
    "./types": "./src/types/index.ts",
    "./utils": "./src/utils/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts,.tsx",
    "test": "node --test --experimental-strip-types test/*.test.ts 2>/dev/null || node --test",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@dte/shared": "workspace:*"
  },
  "devDependencies": {
    "@dte/config-typescript": "workspace:*",
    "typescript": "^5.6.3"
  }
}
